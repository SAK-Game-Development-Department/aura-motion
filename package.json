{
  "name": "aura",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "setup:assets": "node scripts/copy-mediapipe.mjs",
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-pages-limits.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fuzz": "FUZZ_SEEDS=10000 vitest run tests/unit/stage-fuzz.test.ts",
    "e2e": "playwright test",
    "soak": "SOAK_MINUTES=${SOAK_MINUTES:-30} playwright test --config tests/soak/playwright.soak.config.ts",
    "check:pages": "node scripts/check-pages-limits.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e",
    "zip": "node scripts/make-zip.mjs",
    "serve:local": "node scripts/serve-local.mjs"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
